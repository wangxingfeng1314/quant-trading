# A股量化交易系统配置文件
# 复制此文件为 .env 并填入你的配置
# ⚠️ 注意: .env 文件包含敏感信息（Token），已被 .gitignore 排除，不会提交到 Git

# Tushare Pro Token (在 https://tushare.pro 注册获取)
TUSHARE_TOKEN=your_token_here

# TickFlow API Key (在 https://tickflow.org 控制台生成，可选)
TICKFLOW_API_KEY=your_key_here
# TickFlow 服务地址 (完整服务需Key; 免费服务仅历史日K: https://free-api.tickflow.org)
# TICKFLOW_BASE_URL=https://api.tickflow.org

# 数据库路径 (相对于项目根目录)
DB_PATH=data/quant.db

# 数据起始日期 (YYYYMMDD，拉取5年数据)
DATA_START_DATE=20210701

# 佣金费率
COMMISSION_RATE=0.00025
MIN_COMMISSION=5.0
STAMP_TAX_RATE=0.0005
TRANSFER_FEE_RATE=0.00001

# 滑点：默认固定千 1。下面三项默认关闭（保持既有回测基线），
# 打开后历史收益会下降，建议先在样本外验证里做新旧对拍再启用。
SLIPPAGE_RATE=0.001
# MAX_PARTICIPATION_RATE=0.1   # 单笔下单量 <= 信号日成交量 * 该比例（0=不限制）
# SLIPPAGE_IMPACT_K=0.5       # 平方根冲击成本系数：k * 日波动率 * sqrt(参与率)
# MAX_IMPACT_PCT=0.02         # 额外冲击滑点上限

# 默认初始资金 (回测用)
DEFAULT_CAPITAL=100000

# 定时任务 (每日收盘后更新数据，与 core/config.py 默认值一致)
# 部署二选一：APScheduler 服务 或 Windows 计划任务；双入口同时开启时
# 数据更新由文件锁串行、当日推送由 notify_log 去重。
SCHEDULER_ENABLED=true
SCHEDULER_HOUR=15
SCHEDULER_MINUTE=10

# 消息推送 (可选，至少配置一个即可)
# Server酱 https://sct.ftqq.com
SERVER_CHAN_KEY=
# PushPlus https://www.pushplus.plus
PUSHPLUS_TOKEN=
# 企业微信 / 钉钉 / 飞书机器人 Webhook
# 仅允许 https + 官方域名，禁用内网地址与重定向；自建代理需开启下方开关
WECOM_WEBHOOK=
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
FEISHU_WEBHOOK=
WEBHOOK_ALLOW_CUSTOM_HOST=false

# ============================================================
# 登录认证 (可选)
# APP_AUTH_ENABLED=true 时**必须**设置至少 8 位 APP_AUTH_PASSWORD
# 或 PBKDF2 哈希 APP_AUTH_PASSWORD_HASH（迭代$salt十六进制$哈希十六进制），
# 否则应用拒绝启动。系统不再提供任何硬编码默认口令。
# ============================================================
APP_AUTH_ENABLED=false
APP_AUTH_PASSWORD=
# APP_AUTH_PASSWORD_HASH=200000$<salt_hex>$<hash_hex>
# APP_AUTH_SESSION_TTL=28800   # 登录会话有效期（秒，默认 8 小时）
# APP_AUTH_MAX_FAILS=5         # 连续失败达到该次数后指数退避锁定
