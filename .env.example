# A股量化交易系统配置文件
# 复制此文件为 .env 并填入你的配置
# ⚠️ 注意: .env 文件包含敏感信息（Token），已被 .gitignore 排除，不会提交到 Git

# Tushare Pro Token (在 https://tushare.pro 注册获取)
TUSHARE_TOKEN=your_token_here

# 数据库路径 (相对于项目根目录)
DB_PATH=data/quant.db

# 数据起始日期 (YYYYMMDD，拉取5年数据)
DATA_START_DATE=20210701

# 佣金费率
COMMISSION_RATE=0.00025
MIN_COMMISSION=5.0
STAMP_TAX_RATE=0.0005
TRANSFER_FEE_RATE=0.00001
SLIPPAGE_RATE=0.001

# 默认初始资金 (回测用)
DEFAULT_CAPITAL=100000

# 定时任务 (每日收盘后更新数据)
SCHEDULER_ENABLED=true
SCHEDULER_HOUR=18
SCHEDULER_MINUTE=0

# 消息推送 (可选，至少配置一个即可)
# Server酱 https://sct.ftqq.com
SERVER_CHAN_KEY=
# PushPlus https://www.pushplus.plus
PUSHPLUS_TOKEN=
